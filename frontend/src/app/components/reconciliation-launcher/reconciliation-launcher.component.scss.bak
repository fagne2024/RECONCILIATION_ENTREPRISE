:host {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  background: #f1efeb;
}

.reconciliation-launcher-page {
  --nav: #1b2538;
  --bg: #f1efeb;
  --ink: #243044;
  --muted: #8b95a3;
  --green: #27ae60;
  --green-bg: #f3fcf6;
  --blue: #3498db;
  --red: #d9382b;
  --violet-start: #667eea;
  --violet-end: #764ba2;
  --accent: #b8651b;

  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  width: 100%;
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  background: var(--bg);
  color: var(--ink);

  .topbar {
    background: var(--nav);
    color: #fff;
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 32px;
    gap: 16px;
    font-size: 12px;
    font-weight: 600;

    .brand {
      font-family: 'Instrument Serif', Georgia, serif;
      font-size: 16px;
      font-weight: 400;
      padding-right: 16px;
      border-right: 1px solid #ffffff30;
    }
  }

  .head {
    background: #fbfaf8;
    border-bottom: 1px solid #e3e0da;
    padding: 14px 32px 10px;

    small {
      display: block;
      font-size: 11px;
      letter-spacing: .12em;
      color: var(--muted);
      font-weight: 600;
      margin-bottom: 4px;
    }

    h2 {
      font-family: 'Instrument Serif', Georgia, serif;
      font-weight: 400;
      font-size: 22px;

      em {
        color: var(--accent);
      }
    }
  }

  main {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 16px 20px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    overflow-y: auto;

    .title {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 8px;

      .ico {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #3b82f6;
        display: grid;
        place-items: center;
        font-size: 16px;
        flex-shrink: 0;
      }
    }

    h1 {
      font-size: 26px;
      font-weight: 700;
      margin: 0 0 4px;
    }

    .sub {
      color: var(--muted);
      font-size: 13px;
      margin-top: 2px;
    }

    h3 {
      font-size: 18px;
      font-weight: 700;
      margin: 24px 0 18px;
    }

    .cards {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      flex: 1 1 auto;
      align-items: stretch;
      justify-content: center;
      margin-inline: auto;
      text-align: left;

      .card {
        background: #fff;
        border-radius: 11px;
        padding: 22px 20px 20px;
        min-height: 300px;
        border: 1px solid transparent;
        box-shadow: 0 1px 4px #0000000d;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: border-color .2s, background .2s, box-shadow .2s;

        &.selected {
          border-color: var(--green);
          background: var(--green-bg);
          box-shadow: 0 6px 18px #27ae6022;
        }

        h4 {
          font-size: 16px;
          font-weight: 700;
          display: flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 14px;

          span {
            font-size: 20px;
          }
        }

        .desc {
          font-size: 12.5px;
          line-height: 1.4;
          color: var(--muted);
          margin-bottom: 16px;
        }

        ul {
          list-style: none;
          padding: 0;
          font-size: 12.5px;
          line-height: 1.3;
          margin-bottom: 14px;

          li {
            display: flex;
            gap: 7px;
            margin-bottom: 12px;

            &::before {
              content: "\2713";
              color: var(--green);
              font-weight: 700;
              flex-shrink: 0;
              font-size: 11px;
            }
          }
        }

        .btn {
          width: 100%;
          border: 0;
          border-radius: 6px;
          padding: 10px;
          font: 600 12px 'Plus Jakarta Sans', sans-serif;
          color: #fff;
          cursor: pointer;
          margin-top: auto;
          transition: filter .15s, transform .1s;

          &:hover {
            filter: brightness(1.07);
          }

          &:active {
            transform: translateY(1px);
          }

          &:focus-visible {
            outline: 3px solid var(--nav);
            outline-offset: 2px;
          }

          &.b-green { background: var(--green); }
          &.b-blue { background: var(--blue); }
          &.b-violet { background: linear-gradient(135deg, var(--violet-start), var(--violet-end)); padding: 10px 8px; line-height: 1.2; }
        }
      }
    }

    .actions {
      margin-top: 0;
      padding-top: 28px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;

      .go,
      .reset {
        border: 0;
        border-radius: 6px;
        color: #fff;
        font: 700 13px 'Plus Jakarta Sans', sans-serif;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;

        &:focus-visible {
          outline: 3px solid var(--nav);
          outline-offset: 2px;
        }
      }

      .go {
        background: linear-gradient(#2ecc71, #27ae60);
        padding: 11px 22px;
        font-size: 13.5px;

        &:disabled {
          background: #b9c2bd;
          cursor: not-allowed;
        }
      }

      .reset {
        background: linear-gradient(#e74c3c, #c0392b);
        padding: 9px 20px;
        font-size: 12px;
        font-weight: 600;

        &:disabled {
          background: #b9c2bd;
          cursor: not-allowed;
        }
      }
    }
  }

  /* ===== POPUP RECONCILIATION MAGIQUE ===== */
  .magic-overlay {
    position: fixed;
    inset: 0;
    background: #1b253899;
    backdrop-filter: blur(3px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 50;

    &.open {
      display: flex;
    }
  }

  .magic-modal {
    background: #fff;
    width: 100%;
    max-width: 540px;
    max-height: 90vh;
    overflow: auto;
    border-radius: 14px;
    box-shadow: 0 20px 50px #00000045;
    padding: 24px;
    text-align: left;
    animation: magic-pop .18s ease-out;

    .m-head {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 20px;

      .m-ico {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--violet-start), var(--violet-end));
        display: grid;
        place-items: center;
        font-size: 18px;
        flex: none;
      }

      .m-head-txt {
        min-width: 0;

        h5 {
          font-size: 17px;
          font-weight: 700;
          margin: 0;
        }

        p {
          font-size: 12.5px;
          color: var(--muted);
          margin: 3px 0 0;
        }
      }

      .m-x {
        margin-left: auto;
        border: 0;
        background: none;
        font-size: 20px;
        line-height: 1;
        color: var(--muted);
        cursor: pointer;
        border-radius: 6px;
        padding: 4px 8px;
        flex: none.

        &:hover {
          background: var(--bg);
          color: var(--ink);
        }

        &:focus-visible {
          outline: 3px solid var(--nav);
          outline-offset: 2px;
        }
      }
    }

    .m-sec {
      margin-bottom: 18px.

      .lab {
        display: flex.
        justify-content: space-between.
        align-items: center.
        font-size: 12.5px.
        font-weight: 700.
        margin-bottom: 5px.
      }

      .hint {
        font-size: 12px.
        color: var(--muted).
        margin: 0 0 8px.
      }
    }

    .badge {
      background: #eef2ff.
      color: #4c5bd4.
      border-radius: 99px.
      padding: 1px 8px.
      font-size: 11px.
    }

    .drop {
      border: 1.5px dashed #cfd5dd.
      border-radius: 9px.
      padding: 14px.
      display: flex.
      align-items: center.
      gap: 10px.
      background: #fbfaf8.
      transition: .15s.

      &.over {
        border-color: #667eea.
        background: #f0f2ff.
      }

      &.filled {
        border-style: solid.
        border-color: var(--green).
        background: var(--green-bg).
      }

      .txt {
        flex: 1.
        min-width: 0.
        font-size: 13px.
        color: var(--muted).
        overflow: hidden.
        text-overflow: ellipsis.
        white-space: nowrap.
      }

      &.filled .txt {
        color: var(--ink).
        font-weight: 600.
      }
    }

    .hidden-input {
      display: none.
    }

    .sm {
      border: 0.
      border-radius: 5px.
      padding: 8px 13px.
      font: 600 12px 'Plus Jakarta Sans', sans-serif.
      color: #fff.
      background: var(--blue).
      cursor: pointer.
      white-space: nowrap.

      &:hover { filter: brightness(1.07); }
      &:active { transform: translateY(1px); }
      &:focus-visible { outline: 3px solid var(--nav); outline-offset: 2px; }
    }

    .files {
      list-style: none.
      padding: 0.
      margin: 8px 0 0.
      display: flex.
      flex-direction: column.
      gap: 6px.

      li {
        margin: 0.
        display: flex.
        align-items: center.
        gap: 8px.
        border: 1px solid #e3e0da.
        border-radius: 8px.
        padding: 8px 12px.
        font-size: 12.5px.

        &::before {
          content: "\1F4C4".
        }

        .n {
          flex: 1.
          min-width: 0.
          overflow: hidden.
          text-overflow: ellipsis.
          white-space: nowrap.
          font-weight: 600.
        }

        .z {
          color: var(--muted).
          font-size: 11px.
        }

        button {
          border: 0.
          background: none.
          color: var(--red).
          font: 600 11.5px 'Plus Jakarta Sans', sans-serif.
          cursor: pointer.

          &:focus-visible { outline: 3px solid var(--nav); outline-offset: 2px; }
        }
      }
    }

    .m-foot {
      border-top: 1px solid #ece9e3.
      padding-top: 16px.
      margin-top: 6px.
      display: flex.
      align-items: center.
      gap: 10px.

      .state {
        flex: 1.
        font-size: 12px.
        color: var(--muted).
      }

      .btn-m-cancel,
      .btn-m-launch {
        border: 0.
        border-radius: 6px.
        padding: 10px 16px.
        font: 700 12.5px 'Plus Jakarta Sans', sans-serif.
        color: #fff.
        cursor: pointer.
        white-space: nowrap.

        &:hover { filter: brightness(1.07); }
        &:active { transform: translateY(1px); }
        &:focus-visible { outline: 3px solid var(--nav); outline-offset: 2px; }
        &:disabled {
          background: #c5cbc9.
          cursor: not-allowed.
          filter: none.
        }
      }

      .btn-m-cancel {
        background: #b9c2bd.
      }

      .btn-m-launch {
        background: linear-gradient(135deg, var(--violet-start), var(--violet-end)).
      }
    }
  }

  @keyframes magic-pop {
    from {
      transform: translateY(6px) scale(.98);
      opacity: 0;
    }
  }

  .toast {
    position: fixed.
    bottom: 20px.
    left: 50%.
    transform: translateX(-50%).
    background: var(--nav).
    color: #fff.
    padding: 10px 18px.
    border-radius: 6px.
    font-size: 13px.
    opacity: 0.
    pointer-events: none.
    transition: opacity .2s.
    z-index: 1000.

    &.show {
      opacity: 1.
    }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 1024px) {
    main {
      .cards {
        grid-template-columns: 1fr.
        gap: 16px.
      }

      h1 {
        font-size: 24px.
      }

      .head h2 {
        font-size: 20px.
      }
    }

    .magic-modal {
      max-width: 94vw.
      padding: 20px.
    }
  }

  @media (max-width: 640px) {
    .topbar {
      padding: 0 16px.
      gap: 12px.
    }

    .head {
      padding: 12px 20px 8px.
    }

    main {
      padding: 12px 16px 24px.

      h1 { font-size: 22px. }
      h3 { font-size: 16px; margin: 20px 0 14px; }

      .cards { gap: 12px. }

      .card { padding: 18px 16px 18px; min-height: 260px; }

      .actions { gap: 16px; padding-top: 20px; }

      .go { padding: 10px 20px; font-size: 13px; }
      .reset { padding: 8px 18px; font-size: 11.5px; }
    }

    .magic-modal {
      padding: 18px.
      border-radius: 12px.

      .m-head { gap: 12px; margin-bottom: 16px; }
      .m-ico { width: 34px; height: 34px; font-size: 16px; }
      .m-sec { margin-bottom: 14px; }
      .drop { padding: 12px; gap: 8px; }
      .sm { padding: 7px 11px; font-size: 11.5px; }
      .files li { padding: 7px 10px; font-size: 12px; }
      .m-foot { padding-top: 14px; gap: 8px; }
      .btn-m-cancel, .btn-m-launch { padding: 9px 14px; font-size: 12px; }
    }

    .actions .go { padding: 10px 18px; font-size: 12.5px; }
    .actions .reset { padding: 8px 16px; font-size: 11.5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .magic-modal {
      animation: none;
    }
  }
}
