{
  "name": "csv-reconciliation-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "cross-env NODE_OPTIONS=--no-deprecation ng serve --ssl --ssl-key C:/Certs/reconciliation/reconciliation.intouchgroup.net-key.pem --ssl-cert C:/Certs/reconciliation/reconciliation.intouchgroup.net-crt.pem --host 0.0.0.0 --disable-host-check --live-reload=false",
    "start-http": "cross-env NODE_OPTIONS=--no-deprecation ng serve",
    "start:test": "cross-env NODE_OPTIONS=--no-deprecation ng serve --proxy-config proxy.test.conf.json --port 4201",
    "build": "cross-env NODE_OPTIONS=--no-deprecation ng build",
    "watch": "cross-env NODE_OPTIONS=--no-deprecation ng build --watch --configuration development",
    "test": "cross-env NODE_OPTIONS=--no-deprecation ng test",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage"
  },
  "private": true,
  "dependencies": {
